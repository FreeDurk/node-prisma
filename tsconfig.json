{
  "compilerOptions": {
    "experimentalDecorators": true, 
    "emitDecoratorMetadata": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "prisma",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}